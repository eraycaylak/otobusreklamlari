# Merkez sunucu systemd unit dosyasi.
#
# BU DOSYAYI ELLE KOPYALAMAYIN - scripts/sistem-kurulum.sh kullanin:
#   sudo ./scripts/sistem-kurulum.sh
#
# Sebep: unit asagidaki UC seyin var olmasini bekliyor ve hicbirini kendisi
# olusturmuyor:
#   - `reklam` sistem kullanicisi
#   - /var/lib/reklam        (DATA_DIR - icinde OZEL IMZALAMA ANAHTARI)
#   - /etc/reklam/sunucu.env (ADMIN_TOKEN)
# Bunlar yoksa systemd servisi HIC BASLATMAZ (eksik EnvironmentFile olumcaldur)
# ve Restart=always yuzunden 5 saniyede bir yeniden dener. journalctl'e bakmayan
# biri icin bu "sunucu calismiyor, sebebi yok" demektir. Kurulum betigi ucunu de
# olusturur ve ADMIN_TOKEN uretir.

[Unit]
Description=Otobus ici reklam yayin sunucusu
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=reklam
Group=reklam
WorkingDirectory=/opt/reklam/sunucu
Environment=NODE_ENV=production
Environment=PORT=8080
Environment=DATA_DIR=/var/lib/reklam
# ADMIN_TOKEN'i burada tutmayin; ayri bir dosyadan okutun:
EnvironmentFile=/etc/reklam/sunucu.env
ExecStart=/usr/bin/node src/index.js
Restart=always
RestartSec=5

# SONSUZ YENIDEN BASLATMA DONGUSUNU DURDUR.
# Yapilandirma hatasi (eksik env dosyasi, bozuk anahtar) her denemede ayni
# sekilde basarisiz olur. Sinirsiz denemek sorunu cozmez, yalnizca journal'i
# doldurur ve servisi "activating" durumunda tutarak arizayi GIZLER. Bes
# denemeden sonra durup `failed` durumunda kalmasi, sorunu GORUNUR kilar.
StartLimitIntervalSec=120
StartLimitBurst=5

# Guvenlik sikilastirmasi
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/reklam
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

# Buyuk video yuklemeleri icin
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
