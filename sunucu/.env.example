# Sunucu ayarlari. Bu dosyayi .env olarak kopyalayip doldurun,
# veya degerleri dogrudan systemd unit dosyasina yazin.

# ZORUNLU: yonetim paneli ve admin API anahtari.
# Uzun ve rastgele olmali:  openssl rand -base64 32
ADMIN_TOKEN=degistir-beni

PORT=8080

# Veri dizini (icerik, loglar, ANAHTARLAR). Yedeklenmesi gereken tek dizin budur.
# DATA_DIR=/var/lib/reklam

# --- Transcode hedefi -------------------------------------------------------
# Projenin en buyuk kazanci burasi: 50 MB'lik reklam ~10 MB'a duser ve
# 3 dakikalik pencere yeterli hale gelir.
# VIDEO_BITRATE=2500k
# VIDEO_MAXRATE=3500k
# VIDEO_WIDTH=1920
# VIDEO_HEIGHT=1080
# VIDEO_FPS=25
# AUDIO_BITRATE=128k

# Bozuk bir video ffmpeg'i sonsuza kadar askida birakabilir; bu sure sonunda oldurulur.
# TRANSCODE_TIMEOUT_MS=1800000

# Ayni anda kac transcode calissin. ffmpeg -preset slow tum cekirdekleri doyurur;
# birden fazlasi sunucuyu kilitler ve o sirada manifest bekleyen otobusler
# zaman asimina ugrar (pencere bosa gider).
# MAX_CONCURRENT_TRANSCODE=1

# ffmpeg PATH'te degilse tam yol verin
# FFMPEG_BIN=/usr/bin/ffmpeg
# FFPROBE_BIN=/usr/bin/ffprobe

# Parca boyutu (bayt). 4 MB: kopma aninda kaybedilen is kucuk, manifest sismiyor.
# CHUNK_SIZE=4194304

# Kademeli yayim grup sayisi.
# DIKKAT: cihaz tarafi bu degeri manifestten okur; elle senkronlamaya gerek yok.
# ROLLOUT_GROUPS=4

# Anahtar yollari (varsayilan: DATA_DIR/keys/)
# PRIVATE_KEY_PATH=/var/lib/reklam/keys/ed25519-private.pem
# PUBLIC_KEY_PATH=/var/lib/reklam/keys/ed25519-public.pem

# --- Ses -------------------------------------------------------------------
# VARSAYILAN KAPALI ve bu bir BANT GENISLIGI karari: oynatici sessiz calistigi icin
# ses akisini kodlamak, asla duyulmayacak ~128 kbit/s'yi her dosyaya eklemekti
# (30 sn'lik reklamda ~480 KB, dosyanin ~%5'i). 3 dakikalik pencereye sigmak icin
# kurulmus bir sistemde bu kucuk bir sayi degil.
# AUDIO=1 yaparsaniz ses KODLANIR ve policy.volume ile oynatici da sesi acar.
# DIKKAT: daha once yuklenmis dosyalarda ses akisi YOKTUR, yeniden yuklenmeleri gerekir.
# AUDIO=0
# VOLUME=1
# VIDEO_BUFSIZE=5000k

# --- Saat dilimi -----------------------------------------------------------
# Daypart ("07:00-10:00") BU dilimde yorumlanir ve deger manifestle cihaza gider.
# Cihazin kendi dilimine BIRAKILAMAZ: ucuz stick'lerde tipik olarak UTC cikar ve
# Turkiye icin bu 3 saatlik kaymadir - sabah kusagi reklami ogleden sonra doner.
# Gecersiz bir IANA adi acilista REDDEDILIR (sessizce UTC'ye dusmesin).
# TIMEZONE=Europe/Istanbul

# --- Ters vekil / onbellek kutusu -----------------------------------------
# Onumuzde kac GUVENILIR vekil var? Deneme sinirinin dayandigi req.ip bundan
# uretiliyor. 'true' vermek X-Forwarded-For'u istemciye birakir ve siniri tamamen
# atlatilabilir kilar; bu yuzden burada bir SAYI istiyoruz. Dogrudan erisimde 0.
# TRUST_PROXY_HOPS=0

# /content icin cihaz tokeni istenecek mi? Varsayilan ACIK (1).
# Kapatma kacisi (0), Authorization basligini gecirmeyen bir ara sunucunun TUM
# filonun indirmesini durdurmasina karsi. /app (APK) icin boyle bir kacis YOK:
# o dosya PROVISION_SECRET tasiyor.
# CONTENT_AUTH=1

# Bir cihaz kac saat senkron olmazsa panelde "bayat" sayilir.
# STALE_HOURS=72

# --- Sinirlar --------------------------------------------------------------
# Tek yuklemenin ust siniri (bayt). Sinirsiz birakmak tek istekle diski doldurabilirdi.
# MAX_UPLOAD_BYTES=2147483648

# Cihazdan gelen gzip'li log govdesinin ACILMIS hali icin ust sinir (bayt).
# Sikistirma bombasina karsi: 32 MB'lik govde sinirsiz acilabilirdi ve tek istekle
# sunucunun bellegini tuketebilirdi. Bir log satiri ~200 bayt.
# MAX_LOG_BYTES=16777216

# Sure olcumu (ffprobe) zaman asimi. Bozuk bir mp4 ffprobe'u kilitleyince yukleme
# istegi sonsuza kadar asili kaliyordu.
# PROBE_TIMEOUT_MS=60000

# Ayni cihazdan iki kanit karesi arasindaki EN AZ sure. "Gunde bir kare" kurali
# cihazda da var ama cihaz guvenilmeyen taraftir; sunucu kendi kuralini uygular.
# PROOF_MIN_ARALIK_MS=21600000

# Rapor araligi sinirlari. Rapor uclari ilgili tum gunleri bellege okuyor: sinirsiz
# birakmak, okuma suresince sunucuyu TUM otobuslere kapatmak demekti.
# Tarih verilmezse son RAPOR_VARSAYILAN_GUN gun raporlanir.
# RAPOR_VARSAYILAN_GUN=90
# RAPOR_MAX_GUN=400
