<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Android 10+ da baglanilan aginin SSID'sini okumak icin konum izni gerekiyor.
         Cihaz sahibi (device owner) oldugumuz icin bu izni kendimize veriyoruz. -->
    <!--
      ACCESS_FINE_LOCATION: konum icin DEGIL - Android 10+ WiFi tarama/profil
      islemleri bu izni sart kosuyor (bkz. DeviceAdmin.ensureWifi).

      uses-feature required=false ZORUNLU: Android, konum iznini gorunce cihazda GPS
      DONANIMI oldugunu VARSAYAR. Bu stick'lerde GPS yok; beyan edilmezse dagitim
      katmanlari (Play, bazi MDM/OEM magazalari) cihazi "uyumsuz" sayip kurulumu
      engelleyebilir - ve bu, hicbir kod hatasi olmadan filoyu durduran bir seydir.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!--
      COARSE DE BEYAN EDILMEK ZORUNDA - kozmetik degil, RUNTIME sarti.
      Android 12 (API 31) ve sonrasinda FINE konum izni, COARSE beyan edilmeden
      ISTENEMEZ: platform istegi yok sayar. Yani yalnizca FINE beyan edildiginde
      dpm ile verilen yetki YENI ROM'LARDA ETKISIZ kalir ve WiFi profili yazilamaz -
      cihaz aga hic baglanmaz. Bu, yalnizca yeni bir stick modeli alindiginda ve
      ancak SAHADA ortaya cikacak bir arizaydi; bloklayici lint tam bu sinifi yakaladi.
    -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <!-- Android TV stick: dokunmatik ekran YOK (kumanda ile kullaniliyor),
         leanback de zorunlu degil. (touchscreen satiri iki kez yazilmisti.) -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/ic_banner"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.Oynatici">

        <!--
          PlayerActivity HEM launcher HEM HOME.
          HOME olmasi kritik: uygulama cokerse Android HOME'u yeniden baslatir,
          yani sistem bize bedava bir watchdog saglar. Cihaz sahibi olarak
          addPersistentPreferredActivity ile bu secim kalici hale getiriliyor.
        -->
        <activity
            android:name=".player.PlayerActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="landscape"
            tools:ignore="DiscouragedApi"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density|fontScale|layoutDirection|locale|navigation|touchscreen|colorMode|grammaticalGender"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.Oynatici">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".sync.SyncService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver
            android:name=".boot.BootReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!--
          Cihaz sahibi alicisi. dpm set-device-owner bu bileseni hedefler.
        -->
        <receiver
            android:name=".admin.AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!--
          Provizyon alicisi.
          GUVENLIK: exported olmak zorunda (adb shell am broadcast ile cagriliyor),
          ama iki katmanla korunuyor:
            1) PROVIZYON yayini yalnizca cihaz HENUZ PROVIZYONLANMAMISKEN kabul edilir
            2) BuildConfig.PROVISION_SECRET ile eslesmeyen yayin reddedilir
               (sabit zamanli karsilastirma)
          NETWORK yayini provizyondan sonra da calisir ama yalnizca ag/sunucu adresini
          degistirir; cihaz KIMLIGINE (deviceId/token) dokunmaz.

          lint ExportedReceiver: alici bir IZIN ile korunmus degil - bilincli. Izin
          tabanli koruma burada ISE YARAMAZ, cunku cagiran taraf `adb shell`, yani
          uygulamamiz degil kabuk kullanicisi; ona verilecek bir imza izni yok.
          Erisim fiziksel adb baglantisi + paylasilan sir ile sinirli. Sirri bilmeyen
          bir yayin, cihazin durumunu HIC degistirmez.
        -->
        <receiver
            android:name=".provision.ProvisionReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="com.otobusreklam.player.PROVISION" />
                <!--
                  AG BILGISI GUNCELLEME: yalnizca ssid/psk/baseUrl degistirir, cihaz
                  KIMLIGINE (deviceId/token) dokunmaz. Provizyondan sonra da calisir.
                  Olmadan AP parolasinin degismesi TUM filoyu erisilemez kiliyor ve tek
                  cikis yolu her otobuse gidip fabrika ayarlarina donmek oluyordu.
                -->
                <action android:name="com.otobusreklam.player.NETWORK" />
            </intent-filter>
        </receiver>

        <!-- Sessiz APK kurulumunun sonucunu almak icin -->
        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false" />
    </application>
</manifest>
