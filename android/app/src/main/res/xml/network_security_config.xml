<?xml version="1.0" encoding="utf-8"?>
<!--
  Duz HTTP'ye neden izin veriyoruz:

  Onbellek kutusu toplanma noktasinda, kapali bir VLAN'da duruyor. Ona sertifika
  kurmak (ve 50 cihaza guven deposu dagitmak) buyuk bir isletme yuku; karsiliginda
  kazanilan tek sey GIZLILIK - reklam videolarinin gizli bir yani yok.

  BUTUNLUK ayri bir mekanizmayla zaten saglaniyor: manifest Ed25519 ile imzali ve
  her parca SHA-256 ile dogrulaniyor. Yani ag uzerinde biri araya girse bile
  cihaza sahte/degistirilmis reklam yukleyemez - sadece trafigi izleyebilir.

  Merkez sunucu internete acilacaksa HTTPS kullanin; o zaman burayi false yapin.
-->
<network-security-config xmlns:tools="http://schemas.android.com/tools">
    <!--
      lint InsecureBaseConfiguration: bilincli. Gizlilik burada ikincil (icerik zaten
      halka acik otobus ekranlarinda yayinlaniyor); BUTUNLUK ise taşımadan degil
      Ed25519 IMZASINDAN geliyor - araya giren biri gecerli manifest uretemez.
      TLS'in bedeli ise gercek: nokta onbelleginde Range/onbellekleme karmasiklasir ve
      her kutuya sertifika yonetimi girer. Merkez internete acilirsa buradaki degeri
      false yapin (bkz. yukaridaki not).
    -->
    <base-config cleartextTrafficPermitted="true" tools:ignore="InsecureBaseConfiguration">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
